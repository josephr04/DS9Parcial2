<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/white">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Ícono de tipo de notificación -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardIcono"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            app:cardCornerRadius="23dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#F0E6FF">

            <ImageView
                android:id="@+id/ivIcono"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_notificaciones"
                app:tint="@color/purple_primary" />

        </androidx.cardview.widget.CardView>

        <!-- Punto azul de no leído -->
        <View
            android:id="@+id/viewPuntoNoLeido"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:background="@drawable/circle_badge"
            android:visibility="gone" />

        <!-- Título -->
        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/cardIcono"
            android:layout_toStartOf="@id/viewPuntoNoLeido"
            android:layout_marginStart="14dp"
            android:text="Cambio de estado"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#1A1A2E" />

        <!-- Descripción -->
        <TextView
            android:id="@+id/tvDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvTitulo"
            android:layout_toEndOf="@id/cardIcono"
            android:layout_marginStart="14dp"
            android:layout_marginTop="3dp"
            android:text="Tu incidencia ha cambiado de estado."
            android:textSize="13sp"
            android:textColor="@color/gray_inactive"
            android:lineSpacingMultiplier="1.3" />

        <!-- Tiempo -->
        <TextView
            android:id="@+id/tvTiempo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvDescripcion"
            android:layout_toEndOf="@id/cardIcono"
            android:layout_marginStart="14dp"
            android:layout_marginTop="6dp"
            android:text="Hace 5 min"
            android:textSize="11sp"
            android:textColor="@color/gray_inactive" />

    </RelativeLayout>

</androidx.cardview.widget.CardView>