<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF0F0F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="28dp"
        android:paddingTop="48dp"
        android:paddingBottom="32dp">

        <!-- Logo UTP -->
        <ImageView
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:src="@drawable/logo_utp"
            android:contentDescription="Logo UTP"
            android:scaleType="fitCenter" />

        <!-- Título -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Gestión de Incidentes"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#7B1FA2"
            android:gravity="center"
            android:fontFamily="sans-serif-medium" />

        <!-- Subtítulo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Sistema Central de Reportes Institucionales"
            android:textSize="13sp"
            android:textColor="#888888"
            android:gravity="center" />

        <!-- Tarjeta del formulario -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Label correo -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CORREO INSTITUCIONAL"
                    android:textSize="11sp"
                    android:textColor="#888888"
                    android:letterSpacing="0.08"
                    android:textStyle="bold" />

                <!-- Campo correo -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input_field"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp">

                    <EditText
                        android:id="@+id/etCorreo"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="usuario@utp.ac.pa"
                        android:inputType="textEmailAddress"
                        android:textSize="15sp"
                        android:textColor="#333333"
                        android:imeOptions="actionNext"
                        android:textColorHint="#999999"/>

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_email"
                        android:alpha="0.4" />
                </LinearLayout>

                <!-- Fila label contraseña + olvidé -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="CONTRASEÑA"
                        android:textSize="11sp"
                        android:textColor="#888888"
                        android:letterSpacing="0.08"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtOlvideClave"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="¿Olvidó su clave?"
                        android:textSize="12sp"
                        android:textColor="#7B1FA2"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- Campo contraseña -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input_field"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_lock"
                        android:alpha="0.4" />

                    <EditText
                        android:id="@+id/etPassword"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:background="@null"
                        android:hint="••••••••"
                        android:inputType="textPassword"
                        android:textSize="15sp"
                        android:textColor="#333333"
                        android:imeOptions="actionDone"
                        android:textColorHint="#999999"/>

                    <ImageView
                        android:id="@+id/btnTogglePassword"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_visibility_off"
                        android:alpha="0.4"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- Mantener sesión -->
                <CheckBox
                    android:id="@+id/chkMantenerSesion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Mantener sesión iniciada"
                    android:textSize="14sp"
                    android:textColor="#555555"
                    android:buttonTint="#7B1FA2" />

                <!-- Progress bar -->
                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="8dp"
                    android:visibility="gone"
                    android:indeterminateTint="#7B1FA2" />

                <!-- Botón iniciar sesión -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnIniciarSesion"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="8dp"
                    android:text="Iniciar Sesión"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="#6A0DAD"
                    app:iconGravity="end"
                    app:icon="@drawable/ic_arrow_forward"
                    app:iconTint="#FFFFFF"
                    app:iconPadding="8dp" />

                <!-- Divisor -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="20dp"
                    android:background="#EEEEEE" />

                <!-- Crear cuenta -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="¿Nuevo en la plataforma?"
                    android:textSize="13sp"
                    android:textColor="#888888" />

                <TextView
                    android:id="@+id/btnCrearCuenta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="4dp"
                    android:text="Crea tu cuenta"
                    android:textSize="15sp"
                    android:textColor="#7B1FA2"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>